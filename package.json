{
  "name": "ops-ai-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:shared": "npm run build --workspace=packages/shared",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:worker": "npm run dev --workspace=apps/worker",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:web\"",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:api": "npm run build --workspace=apps/api",
    "build:worker": "npm run build --workspace=apps/worker",
    "build:web": "npm run build --workspace=apps/web",
    "build": "npm run build:shared && npm run build:api && npm run build:worker && npm run build:web",
    "seed": "npm run seed --workspace=apps/api",
    "test": "npm run test --workspace=apps/api && npm run test --workspace=apps/worker"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
